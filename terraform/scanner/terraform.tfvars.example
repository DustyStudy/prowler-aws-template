# Copy to terraform.tfvars (gitignored) and fill in.

# Required: the GitHub repo that runs the scan workflow (your copy of this template).
github_owner    = "your-github-org"
github_repo     = "prowler-aws"
github_owner_id = 12345678  # gh api repos/<owner>/<repo> --jq '.owner.id, .id'
github_repo_id  = 987654321

# Optional
# report_email = "security-team@example.com"  # post-scan email with HTML reports attached (SES)
# budget_email = "you@example.com"
# budget_limit_usd = 5
# report_retention_days = 365
# create_github_oidc_provider = false  # if the account already has the GitHub OIDC provider
