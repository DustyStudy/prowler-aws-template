# The Prowler release the scan runs. To upgrade, change the version, then
# recompile the hash-pinned lock for the runner (Linux, Python 3.12):
#
#   uv pip compile requirements/prowler.in \
#     --overrides requirements/prowler-overrides.txt --generate-hashes --no-header \
#     --python-version 3.12 --python-platform x86_64-manylinux_2_28 \
#     -o requirements/prowler.txt
prowler==5.45.0

